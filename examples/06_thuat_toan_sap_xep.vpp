// ==========================================
// Bai 6: Thuat toan Sap xep Nhanh (QuickSort)
// ==========================================

ham sap_xep_nhanh(danh_sach) {
    neu (do_dai(danh_sach) <= 1) {
        tra_ve danh_sach;
    }

    bien phan_tu_chot = danh_sach[0];
    bien ds_nho_hon = [];
    bien ds_bang = [];
    bien ds_lon_hon = [];

    lap (x trong danh_sach) {
        neu (x < phan_tu_chot) {
            them(ds_nho_hon, x);
        } khong_thi_neu (x == phan_tu_chot) {
            them(ds_bang, x);
        } khong_thi {
            them(ds_lon_hon, x);
        }
    }

    tra_ve sap_xep_nhanh(ds_nho_hon) + ds_bang + sap_xep_nhanh(ds_lon_hon);
}

bien mang_ban_dau = [88, 12, 45, 9, 73, 26, 35, 1, 99, 54, 17];
in("Mang ban dau chua sap xep:");
in(mang_ban_dau);

bien mang_ket_qua = sap_xep_nhanh(mang_ban_dau);
in("Mang sau khi sap xep tang dan:");
in(mang_ket_qua);
