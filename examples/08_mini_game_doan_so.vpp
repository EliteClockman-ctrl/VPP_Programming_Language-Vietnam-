// ==========================================
//   Mini Game: Đoán Số Bí Mật (Siêu Đơn Giản)
// ==========================================

so_bi_mat = ngẫu_nhiên(1, 100)
nói "========================================="
nói "   TRÒ CHƠI ĐOÁN SỐ BÍ MẬT (1 - 100)     "
nói "========================================="
nói "Máy tính đã chọn 1 số ngẫu nhiên!"

so_lan_doan = 0
gioi_han_duoi = 1
gioi_han_tren = 100

khi đúng {
    so_lan_doan++
    // Thuật toán AI tìm kiếm nhị phân
    luot_doan = số_nguyên((gioi_han_duoi + gioi_han_tren) / 2)
    nói "Lượt", so_lan_doan, "- AI đoán:", luot_doan

    nếu luot_doan == so_bi_mat {
        nói ">>> CHÍNH XÁC! Số bí mật là:", so_bi_mat
        nói ">>> Chiến thắng sau", so_lan_doan, "lần đoán!"
        dừng_lặp
    } hoặc_nếu luot_doan < so_bi_mat {
        nói "    -> Quá nhỏ! Cần số lớn hơn."
        gioi_han_duoi = luot_doan + 1
    } không_thì {
        nói "    -> Quá lớn! Cần số nhỏ hơn."
        gioi_han_tren = luot_doan - 1
    }
}
