// ==========================================
//   Vòng lặp siêu đơn giản trong V++
// ==========================================

nói "--- 1. LẶP N LẦN TRỰC TIẾP ---"
lặp 3 lần {
    nói "V++ lập trình thật là dễ dàng!"
}

nói "--- 2. LẶP TỪ A ĐẾN B ---"
lặp i từ 1 đến 5 {
    nói "Đếm số:", i
}

nói "--- 3. DUYỆT DANH SÁCH ---"
hoa_qua = ["Cam", "Xoài", "Táo", "Nho"]
lặp trai_cay trong hoa_qua {
    nói "Trái cây ngon:", trai_cay
}

nói "--- 4. TÍNH TOÁN 1 DÒNG ---"
diem_so = [8.5, 9.0, 7.5, 10.0]
nói "Tổng điểm   :", tổng(diem_so)
nói "Điểm cao nhất:", lớn_nhất(diem_so)
nói "Điểm thấp nhất:", nhỏ_nhất(diem_so)
