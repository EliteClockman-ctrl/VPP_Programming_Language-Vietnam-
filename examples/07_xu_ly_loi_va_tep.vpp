// ==========================================
// Bai 7: Xu ly loi (Try-Catch) & Lam viec voi Tep tin
// ==========================================

in("--- THU NGHIEM XU LY NGOAI LE ---");

ham chia_an_toan(a, b) {
    thu {
        neu (b == 0) {
            nem_loi "Mau so bang 0, khong the thuc hien phep chia!";
        }
        tra_ve a / b;
    } bat_loi (loi) {
        in("[CANH BAO] Phat hien loi:", loi);
        tra_ve rong;
    } cuoi_cung {
        in("[DON DEP] Hoan thanh khoi tinh toan chia.");
    }
}

bien kq1 = chia_an_toan(100, 4);
in("100 / 4 =", kq1);

bien kq2 = chia_an_toan(100, 0);
in("100 / 0 =", kq2);

in("\n--- THU NGHIEM GHI VA DOC TEP TIN ---");
bien duong_dan = "nhat_ky_vpp.txt";
bien noi_dung_ghi = "Nhat ky he thong V++\\nNgay khoi tao: 2026\\nTrang thai: On dinh tuyet doi\\n";

ghi_tep(duong_dan, noi_dung_ghi);
in("Da ghi thanh cong vao tep:", duong_dan);

bien noi_dung_doc = doc_tep(duong_dan);
in("Noi dung doc duoc tu tep la:\n" + noi_dung_doc);
