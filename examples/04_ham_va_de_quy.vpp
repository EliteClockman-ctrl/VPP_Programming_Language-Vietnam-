// ==========================================
// Bai 4: Ham, De quy & Giai thuat toan hoc
// ==========================================

// 1. Tinh giai thua n!
ham giai_thua(n) {
    neu (n <= 1) {
        tra_ve 1;
    }
    tra_ve n * giai_thua(n - 1);
}

// 2. Tinh so Fibonacci thu n
ham fibonacci(n) {
    neu (n <= 0) { tra_ve 0; }
    neu (n == 1) { tra_ve 1; }
    tra_ve fibonacci(n - 1) + fibonacci(n - 2);
}

// 3. Uoc chung lon nhat (UCLN)
ham uoc_chung_lon_nhat(a, b) {
    khi (b != 0) {
        bien tam = b;
        b = a % b;
        a = tam;
    }
    tra_ve a;
}

in("--- KIEM TRA CAC HAM TOAN HOC ---");
in("Giai thua cua 5 (5!):", giai_thua(5));
in("Giai thua cua 8 (8!):", giai_thua(8));

in("10 so dau tien trong day Fibonacci:");
bien day_fib = [];
lap (i trong pham_vi(0, 10)) {
    them(day_fib, fibonacci(i));
}
in(day_fib);

in("UCLN cua 48 va 180 la:", uoc_chung_lon_nhat(48, 180));
