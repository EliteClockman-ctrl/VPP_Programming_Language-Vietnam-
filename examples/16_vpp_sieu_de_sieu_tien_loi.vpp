// ==========================================================
//   V++ SIÊU DỄ & SIÊU TIỆN LỢI (100% CÚ PHÁP TỰ NHIÊN)
// ==========================================================

nói "=== 1. XỬ LÝ VĂN BẢN SIÊU ĐƠN GIẢN ==="
loi_chao = "chào mừng bạn đến với ngôn ngữ v++"
nói "Chữ hoa     :", chữ_hoa(loi_chao)
nói "Viết hoa đầu:", viết_hoa_đầu(loi_chao)
nói "Số lượng từ :", đếm_từ(loi_chao), "từ"
nói "Đảo ngược   :", đảo_ngược("abcde")

nói ""
nói "=== 2. TÍNH TOÁN DANH SÁCH & THỐNG KÊ 1 DÒNG ==="
diem = [8.5, 9.0, 7.0, 10.0, 6.5]
nói "Danh sách điểm   :", diem
nói "Điểm trung bình  :", trung_bình(diem)
nói "Điểm cao nhất    :", lớn_nhất(diem)
nói "Điểm thấp nhất   :", nhỏ_nhất(diem)
nói "Tổng điểm        :", tổng(diem)
nói "Sắp xếp tăng dần :", sắp_xếp(diem)
nói "Sắp xếp giảm dần :", đảo_ngược(sắp_xếp(diem))
nói "Học sinh may mắn :", chọn_ngẫu_nhiên(["An", "Bình", "Cường", "Dung", "Hoa"])

nói ""
nói "=== 3. VÒNG LẶP TIẾNG VIỆT TỰ NHIÊN ==="
nói "--- Lặp 3 lần trực tiếp: ---"
lặp 3 lần {
    nói "⭐ V++ code vừa ngắn, vừa nhanh, vừa dễ hiểu!"
}

nói ""
nói "--- Lặp từ 1 đến 5: ---"
lặp i từ 1 đến 5 {
    nói "Bước", i, "-> Giá trị bình phương:", i * i
}

nói ""
nói "=== 4. ĐIỀU KIỆN RẼ NHÁNH TỰ NHIÊN ==="
tuoi = 18
nếu tuoi >= 18 {
    nói "Bạn đã đủ tuổi lái xe và bỏ phiếu!"
} không_thì {
    nói "Bạn còn đang trong độ tuổi học sinh."
}

nói ""
nói "=== 5. CHỜ ĐỢI & XỬ LÝ THỜI GIAN ==="
nói "Đang chuẩn bị hoàn tất..."
chờ(0.5)
nói "🎉 Hoàn tất thành công mọi tác vụ mượt mà!"
