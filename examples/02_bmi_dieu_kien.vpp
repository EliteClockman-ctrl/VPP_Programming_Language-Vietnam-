// ==========================================
//   Tính chỉ số BMI & Rẽ nhánh điều kiện
// ==========================================
biến can_nang = 68.5; // kg
biến chieu_cao = 1.75; // m
biến bmi = can_nang / (chieu_cao * chieu_cao);

nói("=========================================");
nói("       TÍNH TOÁN CHỈ SỐ SỨC KHỎE BMI     ");
nói("=========================================");
nói("Chỉ số BMI của bạn là:", làm_tròn(bmi, 2));

nếu (bmi < 18.5) {
    nói("Kết quả đánh giá: Nhẹ cân (Thiếu cân)");
} không_thì_nếu (bmi < 24.9) {
    nói("Kết quả đánh giá: Thể trạng cân đối, rất tốt!");
} không_thì_nếu (bmi < 29.9) {
    nói("Kết quả đánh giá: Tiền béo phì (Thừa cân)");
} không_thì {
    nói("Kết quả đánh giá: Béo phì");
}
