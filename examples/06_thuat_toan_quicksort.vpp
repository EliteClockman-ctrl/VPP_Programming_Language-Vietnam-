// ==========================================
//   Thuật Toán QuickSort (Sắp Xếp Nhanh)
// ==========================================

hàm quicksort(arr) {
    nếu dài(arr) <= 1 {
        trả_về arr
    }

    chot = arr[0]
    nho_hon = []
    bang = []
    lon_hon = []

    lặp x trong arr {
        nếu x < chot {
            thêm(nho_hon, x)
        } hoặc_nếu x = chot {
            thêm(bang, x)
        } không_thì {
            thêm(lon_hon, x)
        }
    }

    trả_về quicksort(nho_hon) + bang + quicksort(lon_hon)
}

nói "========================================="
nói "   THUẬT TOÁN SẮP XẾP QUICKSORT           "
nói "========================================="

mang_chua_sap_xep = [64, 34, 25, 12, 22, 11, 90, 88, 45, 1, 76]
nói "Mảng ban đầu      :", mang_chua_sap_xep

mang_da_sap_xep = quicksort(mang_chua_sap_xep)
nói "Mảng sau khi xếp  :", mang_da_sap_xep
nói "Phần tử nhỏ nhất  :", nn(mang_da_sap_xep)
nói "Phần tử lớn nhất  :", ln(mang_da_sap_xep)
