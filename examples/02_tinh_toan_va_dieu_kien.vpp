// ==========================================
// Bai 2: Tinh toan BMI & Cau truc re nhanh
// ==========================================

ham tinh_bmi(can_nang, chieu_cao) {
    bien bmi = can_nang / (chieu_cao ^ 2);
    tra_ve lam_tron(bmi, 2);
}

ham danh_gia_bmi(bmi) {
    in("Chi so BMI cua ban la:", bmi);
    
    neu (bmi < 18.5) {
        in("Ket qua: Nguoi gay, can bo sung dinh duong.");
    } khong_thi_neu (bmi < 24.9) {
        in("Ket qua: Can doi, suc khoe rat tot!");
    } khong_thi_neu (bmi < 29.9) {
        in("Ket qua: Thua can, can van dong them.");
    } khong_thi {
        in("Ket qua: Beo phi, can chu y che do an.");
    }
}

bien can_nang_kg = 65;
bien chieu_cao_m = 1.72;

bien bmi_ket_qua = tinh_bmi(can_nang_kg, chieu_cao_m);
danh_gia_bmi(bmi_ket_qua);
